# Copie este arquivo para .env e troque as senhas.
# NUNCA faça commit do .env (ele já está no .gitignore).
# Gere senhas fortes com:  python -c "import secrets; print(secrets.token_urlsafe(24))"

APP_NAME="Poor SofaScore API"
DEBUG=false

# --- Usadas pelo docker-compose.yml na PRIMEIRA subida do banco ---
POSTGRES_ADMIN_PASSWORD=troque_senha_admin
APP_DB_NAME=poorsofascore
APP_DB_USER=sofascore_app
APP_DB_PASSWORD=troque_senha_app

# --- Usada pela API (mesmo usuário/senha da aplicação acima) ---
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg://sofascore_app:troque_senha_app@localhost:5432/poorsofascore

# Origens permitidas para o front-end (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
