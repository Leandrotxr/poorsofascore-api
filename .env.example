# Copie este arquivo para .env e troque as senhas.
# NUNCA faça commit do .env (ele já está no .gitignore).
# Gere senhas fortes com:  python -c "import secrets; print(secrets.token_urlsafe(24))"

APP_NAME="Poor SofaScore API"
DEBUG=false

# --- Usadas pelo docker-compose.yml na PRIMEIRA subida do banco ---
POSTGRES_ADMIN_PASSWORD=troque_senha_admin
APP_DB_NAME=poorsofascore
APP_DB_USER=sofascore_app
APP_DB_PASSWORD=troque_senha_app

# --- Usada pela API (mesmo usuário/senha da aplicação acima) ---
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql+psycopg://sofascore_app:troque_senha_app@localhost:5432/poorsofascore

# Origens permitidas para o front-end (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# --- Autenticação ---
# desenvolvimento | producao (em producao, SECRET_KEY é obrigatória e precisa de 32+ caracteres)
AMBIENTE=desenvolvimento
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria_com_32_ou_mais_caracteres
# Minutos até o login vencer (padrão: 8 horas)
TOKEN_EXPIRA_MINUTOS=480

# Primeiro administrador (usado pelo container ao subir, só se o banco não tiver usuários).
# Sem Docker, crie o admin com:  python scripts/criar_usuario.py voce@exemplo.com "Seu Nome" --admin
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# --- Portas do docker compose (mude se já estiverem em uso na sua máquina) ---
# Ex.: com o Postgres do Homebrew ligado, use DB_PORTA=5433. Com o `fastapi dev` ligado, API_PORTA=8001.
DB_PORTA=5432
API_PORTA=8000
WEB_PORTA=8080
